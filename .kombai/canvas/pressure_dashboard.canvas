div class=\"def\" data-kid=\"2-5-2-1-2\" data-name=\"definition 01 Final five overs\"><span class=\"def-num\" data-kid=\"2-5-2-1-2-1\" data-name=\"definition number 01\">01</span><div data-kid=\"2-5-2-1-2-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-1-2-2-1\" data-name=\"definition title Final five overs\">Final five overs</b><p data-kid=\"2-5-2-1-2-2-2\" data-name=\"definition description text\">Last five overs of the innings</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-1-3\" data-name=\"definition 02 Demanding chase\"><span class=\"def-num\" data-kid=\"2-5-2-1-3-1\" data-name=\"definition number 02\">02</span><div data-kid=\"2-5-2-1-3-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-1-3-2-1\" data-name=\"definition title Demanding chase\">Demanding chase</b><p data-kid=\"2-5-2-1-3-2-2\" data-name=\"definition description text\">Required rate ≥16 runs per over</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-1-4\" data-name=\"definition 03 Wicket pressure\"><span class=\"def-num\" data-kid=\"2-5-2-1-4-1\" data-name=\"definition number 03\">03</span><div data-kid=\"2-5-2-1-4-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-1-4-2-1\" data-name=\"definition title Wicket pressure\">Wicket pressure</b><p data-kid=\"2-5-2-1-4-2-2\" data-name=\"definition description text\">Five or more wickets lost</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-1-5\" data-name=\"definition 04 Semi-final / final\"><span class=\"def-num\" data-kid=\"2-5-2-1-5-1\" data-name=\"definition number 04\">04</span><div data-kid=\"2-5-2-1-5-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-1-5-2-1\" data-name=\"definition title Semi-final / final\">Semi-final / final</b><p data-kid=\"2-5-2-1-5-2-2\" data-name=\"definition description text\">Also includes qualifiers and eliminators</p></div></div>\n</div>\n<div class=\"def-col\" data-kid=\"2-5-2-2\" data-name=\"batter-specific definitions column\">\n<h3 data-kid=\"2-5-2-2-1\" data-name=\"batter-specific column heading\">Batter-specific</h3>\n<div class=\"def\" data-kid=\"2-5-2-2-2\" data-name=\"definition 05 First-innings recovery\"><span class=\"def-num\" data-kid=\"2-5-2-2-2-1\" data-name=\"definition number 05\">05</span><div data-kid=\"2-5-2-2-2-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-2-2-2-1\" data-name=\"definition title First-innings recovery\">First-innings recovery</b><p data-kid=\"2-5-2-2-2-2-2\" data-name=\"definition description text\">First half · 2+ wickets lost · batting side</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-2-3\" data-name=\"definition 06 Powerplay collapse\"><span class=\"def-num\" data-kid=\"2-5-2-2-3-1\" data-name=\"definition number 06\">06</span><div data-kid=\"2-5-2-2-3-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-2-3-2-1\" data-name=\"definition title Powerplay collapse\">Powerplay collapse</b><p data-kid=\"2-5-2-2-3-2-2\" data-name=\"definition description text\">Overs 1–6 · 2+ wickets lost · batting side</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-2-4\" data-name=\"definition 07 Middle-order response\"><span class=\"def-num\" data-kid=\"2-5-2-2-4-1\" data-name=\"definition number 07\">07</span><div data-kid=\"2-5-2-2-4-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-2-4-2-1\" data-name=\"definition title Middle-order response\">Middle-order response</b><p data-kid=\"2-5-2-2-4-2-2\" data-name=\"definition description text\">Batting positions 4–6 in pressure or after 2+ wickets</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-2-5\" data-name=\"definition 08 Opener consistency\"><span class=\"def-num\" data-kid=\"2-5-2-2-5-1\" data-name=\"definition number 08\">08</span><div data-kid=\"2-5-2-2-5-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-2-5-2-1\" data-name=\"definition title Opener consistency\">Opener consistency</b><p data-kid=\"2-5-2-2-5-2-2\" data-name=\"definition description text\">30+ runs · SR 160+ · 50%+ runs from boundaries</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-2-6\" data-name=\"definition 09 Middle-order spin handling\"><span class=\"def-num\" data-kid=\"2-5-2-2-6-1\" data-name=\"definition number 09\">09</span><div data-kid=\"2-5-2-2-6-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-2-6-2-1\" data-name=\"definition title Middle-order spin handling\">Middle-order spin handling</b><p data-kid=\"2-5-2-2-6-2-2\" data-name=\"definition description text\">Strike rate and runs above context vs spin</p></div></div>\n</div>\n<div class=\"def-col\" data-kid=\"2-5-2-3\" data-name=\"bowler-specific definitions column\">\n<h3 data-kid=\"2-5-2-3-1\" data-name=\"bowler-specific column heading\">Bowler-specific</h3>\n<div class=\"def\" data-kid=\"2-5-2-3-2\" data-name=\"definition 10 Powerplay partnership break\"><span class=\"def-num\" data-kid=\"2-5-2-3-2-1\" data-name=\"definition number 10\">10</span><div data-kid=\"2-5-2-3-2-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-3-2-2-1\" data-name=\"definition title Powerplay partnership break\">Powerplay partnership break</b><p data-kid=\"2-5-2-3-2-2-2\" data-name=\"definition description text\">Overs 1–6 · stand 30+ · striker 20+ from 12+ balls</p></div></div>\n<div class=\"def\" data-kid=\"2-5-2-3-3\" data-name=\"definition 11 Death-over pressure\"><span class=\"def-num\" data-kid=\"2-5-2-3-3-1\" data-name=\"definition number 11\">11</span><div data-kid=\"2-5-2-3-3-2\" data-name=\"definition content (title + desc)\"><b data-kid=\"2-5-2-3-3-2-1\" data-name=\"definition title Death-over settled-batter pressure\">Death-over settled-batter pressure</b><p data-kid=\"2-5-2-3-3-2-2\" data-name=\"definition description text\">Last five overs · 6+ wickets in hand · stand 30+ · striker 20+ from 12+ balls</p></div></div>\n</div>\n</div>\n</section>\n<section class=\"panel sources\" data-kid=\"2-6