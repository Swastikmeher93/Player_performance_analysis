    "var_2594160b01be": {
      "type": "variant",
      "label": "Pressure rankings — player-led review",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --ink:#32222b; --body:#6f5464; --muted:#8d8188; --line:#ecdbe2;\n  --paper:#fff0f5; --card:#fff; --brand:#E40C93;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\nh1,h2,h3,p{margin:0}\nbutton{font:inherit;color:inherit}\ntd,th,.kpi-value,.sum-score b,.sum-field b,.leader-score,.coverage b{font-variant-numeric:tabular-nums}\n\n/* header */\n.top{height:80px;display:flex;align-items:center;gap:34px;padding:0 40px;background:#fff9fb;border-bottom:1px solid var(--line)}\n.brand{display:flex;align-items:center;gap:11px;flex:0 0 auto}\n.brand-mark{width:38px;height:38px;display:grid;place-items:center;color:#d3007f}\n.brand-mark svg{width:100%;height:100%}\n.brand-name{display:block;font-size:14px;font-weight:800;letter-spacing:.09em;color:#4a303c;white-space:nowrap}\n.brand-sub{display:block;margin-top:3px;font-size:11px;font-weight:700;letter-spacing:.09em;color:#a3708a;white-space:nowrap}\n.topnav{display:flex;gap:2px}\n.topnav button{min-height:40px;padding:0 14px;border:0;border-radius:10px;background:transparent;color:#7d6170;font-size:14px;font-weight:600;cursor:pointer}\n.topnav button.on{background:#fbe3ef;color:#4a2f3b;font-weight:700}\n.top-right{margin-left:auto;display:flex;align-items:center;gap:16px;font-size:13px;color:#6f5464}\n.top-right span{display:inline-flex;align-items:center;gap:7px}\n.led{width:7px;height:7px;border-radius:50%;background:#d85a94;display:inline-block}\n.icon-btn{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--line);border-radius:9px;background:#fff;color:#7d5a6b;font-size:16px;cursor:pointer}\n.avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#f7dde7;color:#6b4b5a;font-size:12px;font-weight:800}\n\n/* page */\n.inner{max-width:1440px;margin:0 auto;padding:26px 40px 34px}\n.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:24px}\nh1{font-size:44px;line-height:1.06;letter-spacing:-.032em;font-weight:650;color:#33232c}\n.coverage{display:flex;gap:32px;text-align:right}\n.coverage span{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#a08c95}\n.coverage b{display:block;margin-top:6px;font-size:15px;font-weight:700;color:#5c3f4c}\n\n.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}\n.kpi{border:1px solid #eee0e6;border-radius:14px;background:#fff;padding:18px 20px;min-height:120px;display:flex;flex-direction:column;justify-content:space-between}\n.kpi.primary{background:linear-gradient(140deg,#fff8fb,#ffe7f0);border-color:#f1c9d9}\n.kpi-label{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#a08c95}\n.kpi-label i{font-size:18px;color:#b5849a}\n.kpi-value{font-size:36px;font-weight:650;line-height:1;letter-spacing:-.03em;color:#33232c;margin-top:12px}\n.kpi-value small{margin-left:8px;font-size:14px;font-weight:500;letter-spacing:0;color:#8d7883}\n.kpi-foot{margin-top:10px;font-size:13px;color:#8d8188}\n\n.panel{background:#fff;border:1px solid #eee0e6;border-radius:14px;box-shadow:0 2px 10px rgba(46,37,43,.035)}\n\n/* review */\n.review{display:grid;grid-template-columns:430px minmax(0,1fr);gap:20px;align-items:start;margin-bottom:20px}\n.board{padding:18px 20px 16px}\n.board-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:12px}\n.board-title{font-size:20px;font-weight:650;letter-spacing:-.02em;color:#3a2833}\n.seg{display:inline-flex;gap:2px;padding:3px;border:1px solid #ecdbe2;border-radius:9px;background:#fbf4f7}\n.seg button{min-height:28px;padding:0 10px;border:0;border-radius:7px;background:transparent;color:#957f89;font-size:12px;font-weight:600;cursor:pointer}\n.seg button.on{background:#fff;color:#5c3f4c;box-shadow:0 1px 4px rgba(46,37,43,.12)}\n.rank-row{display:grid;grid-template-columns:28px minmax(0,1fr) 74px;align-items:center;gap:11px;width:100%;min-height:44px;border:0;border-top:1px solid #f4e9ee;background:transparent;padding:0;text-align:left;cursor:pointer}\n.rank-row:first-of-type{border-top:0}\n.rank-num{font-size:13px;font-weight:700;color:#b8a7ae}\n.rank-main{min-width:0}\n.rank-name{display:block;margin-bottom:6px;font-size:14px;font-weight:650;color:#4d3543;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.track{display:block;height:5px;border-radius:5px;background:#f8e6ed;overflow:hidden}\n.track i{display:block;height:100%;border-radius:inherit;background:#efb9cd}\n.rank-row.on .track i{background:var(--brand)}\n.rank-score{text-align:right;font-size:15px;font-weight:750;color:#5c3f4c}\n.rank-score small{font-size:11px;font-weight:500;color:#a4909b}\n\n.summary{padding:20px 22px 0;background:linear-gradient(135deg,#fff 55%,#fff3f8)}\n.sum-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}\n.sum-meta{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#a3708a;padding-top:4px}\n.role-chip{padding:3px 8px;border:1px solid #f0dde6;border-radius:6px;background:#fff;font-size:11px;letter-spacing:.07em;color:#a3708a}\n.metrics-link{display:inline-flex;align-items:center;gap:7px;border:1px solid #ecdbe2;border-radius:8px;background:#fff;padding:8px 11px;font-size:13px;font-weight:600;color:#6f5464;cursor:pointer;white-space:nowrap}\n.metrics-link i{font-size:14px;color:#a3708a}\n.sum-main{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-top:12px}\n.sum-name{font-size:40px;line-height:1.05;font-weight:650;letter-spacing:-.035em;color:#33232c}\n.sum-sub{margin-top:8px;font-size:13px;color:#8d7883}\n.sum-score{text-align:right;flex:0 0 auto}\n.sum-score span{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#a08c95;padding-bottom:6px}\n.sum-score b{font-size:40px;line-height:1;font-weight:750;letter-spacing:-.03em;color:var(--brand)}\n.sum-score b small{font-size:14px;font-weight:500;letter-spacing:0;color:#a4909b}\n.sum-meter{height:6px;border-radius:6px;background:#f4e6ec;overflow:hidden;margin-top:16px}\n.sum-meter i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#e7a6c0,#c0006f)}\n.sum-fields{display:grid;grid-template-columns:repeat(4,1fr);margin-top:20px;border-top:1px solid #f2e6ec}\n.sum-field{padding:14px 0 18px;border-left:1px solid #f2e3ea;padding-left:20px}\n.sum-field:first-child{border-left:0;padding-left:0}\n.sum-field span{display:block;font-size:11px;color:#a08c95}\n.sum-field b{display:block;margin-top:6px;font-size:24px;font-weight:700;letter-spacing:-.02em;color:#4a323d}\n.sum-field b small{margin-left:5px;font-size:12px;font-weight:500;letter-spacing:0;color:#a4909b}\n\n/* rankings */\n.rankings{margin-bottom:20px;overflow:hidden}\n.rankings-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px 14px}\n.panel-title{font-size:20px;font-weight:650;letter-spacing:-.02em;color:#3a2833}\n.tools{display:flex;align-items:center;gap:10px;padding:0 22px 14px;flex-wrap:wrap}\n.groups{display:flex;gap:4px;flex-wrap:wrap}\n.group-btn{min-height:32px;padding:0 12px;border:1px solid transparent;border-radius:8px;background:#fbf4f7;color:#8d7883;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap}\n.group-btn.on{background:#fbe3ef;border-color:#f2c9da;color:#a31367}\n.search{display:flex;align-items:center;gap:8px;margin-left:auto;width:270px;height:36px;padding:0 10px;border:1px solid #ecdbe2;border-radius:9px;background:#fff;color:#9c8894;font-size:15px}\n.search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;font-size:14px;color:#5c4451}\n.search input::placeholder{color:#a4909b}\n.table-scroll{overflow-x:auto}\ntable{width:100%;border-collapse:collapse}\nthead{background:#fffafb}\nth{height:46px;padding:0 16px;font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#a08c95;text-align:left;white-space:nowrap}\nth:first-child,td:first-child{padding-left:22px}\nth:last-child,td:last-child{padding-right:22px}\ntd{height:44px;padding:0 16px;border-top:1px solid #f2e6ec;font-size:14px;color:#6f5464;white-space:nowrap}\ntr.is-selected{background:#fff4f8}\n.rank-cell{font-size:13px;font-weight:700;color:#a1939a}\n.rank-cell.top{color:#b6718d}\n.player{display:inline-flex;align-items:center;gap:10px;border:0;background:transparent;padding:0;cursor:pointer}\n.initials{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#f9e7ee;border:1px solid #efdde5;color:#986c80;font-size:11px;font-weight:800;flex:0 0 auto}\n.player b{font-size:14px;font-weight:650;color:#4a323d}\n.emph{color:#a35474;font-weight:700}\n.score-badge{display:inline-grid;place-items:center;min-width:56px;height:27px;border-radius:7px;background:#fbe3ef;color:#bd006e;font-size:13px;font-weight:800;font-variant-numeric:tabular-nums}\n.table-foot{display:flex;justify-content:space-between;gap:12px;padding:14px 22px;border-top:1px solid #f2e6ec;font-size:13px;color:#8d8188}\n\n/* definitions */\n.defs{padding:18px 22px 10px;margin-bottom:20px}\n.def-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:0 34px;padding-bottom:14px}\n.def-col h3{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#a3708a;margin:0 0 4px}\n.def{display:grid;grid-template-columns:24px minmax(0,1fr);gap:10px;padding:12px 0;border-top:1px solid #f4e9ee}\n.def-num{font-size:12px;font-weight:700;color:#bda9b2;padding-top:2px}\n.def b{display:block;font-size:14px;font-weight:650;color:#42303a}\n.def p{margin-top:4px;font-size:13px;line-height:1.45;color:#8d8188}\n\n/* sources */\n.sources{display:grid;grid-template-columns:repeat(4,1fr);gap:0 28px;padding:18px 22px 20px}\n.source span{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#a08c95}\n.source b{display:block;margin-top:6px;font-size:15px;font-weight:700;color:#5c3f4c}\n.source p{margin-top:5px;font-size:12px;color:#96818a;line-height:1.45}\n\n.footer{display:flex;justify-content:space-between;gap:20px;padding:0 4px 4px;font-size:13px;color:#96818a}\n.footer b{color:#7d5a6b;font-weight:700}\n</style>\n<header class=\"top\" data-kid=\"1\" data-name=\"header top bar\">\n<div class=\"brand\" data-kid=\"1-1\" data-name=\"brand logo group\">\n<span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1\" data-name=\"brand mark icon container\">\n<svg data-kid=\"1-1-1-1\" data-name=\"hexagonal brand logo with checkmark\" fill=\"none\" viewbox=\"0 0 36 36\"><path d=\"M18 3.5 31 11v14L18 32.5 5 25V11L18 3.5Z\" stroke=\"currentColor\" stroke-width=\"1.6\"></path><path d=\"M11 21.5V14l7-4 7 4v7.5l-7 4-7-4Z\" fill=\"currentColor\"></path><path d=\"m14.5 18 2.2 2.2 4.8-5\" stroke=\"#fff8fb\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\"></path></svg>\n</span>\n<span data-kid=\"1-1-2\" data-name=\"brand name text group\">\n<span class=\"brand-name\" data-kid=\"1-1-2-1\" data-name=\"brand name PRESSURE/PLAY\">PRESSURE<span data-kid=\"1-1-2-1-1\" data-name=\"brand name slash separator\" style=\"color:#e9a8c4\">/</span>PLAY</span>\n<span class=\"brand-sub\" data-kid=\"1-1-2-2\" data-name=\"brand subtitle CRICKET PERFORMANCE\">CRICKET PERFORMANCE</span>\n</span>\n</div>\n<nav aria-label=\"Dashboard sections\" class=\"topnav\" data-kid=\"1-2\" data-name=\"main navigation with section tabs\">\n<button class=\"on\" data-kid=\"1-2-1\" data-name=\"Overview navigation tab (active)\" type=\"button\">Overview</button>\n<button data-kid=\"1-2-2\" data-name=\"Batting navigation tab\" type=