      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --ink:#32222b; --body:#6f5464; --muted:#8d8188; --line:#ecdbe2;\n  --paper:#fff0f5; --card:#ffffff; --brand:#E40C93;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\nh1,h2,h3,p{margin:0}\nbutton{font:inherit;color:inherit}\ntd,.kpi-value,.leader-score,.coverage b{font-variant-numeric:tabular-nums}\n\n.app{display:flex;min-height:100vh;background:var(--paper)}\n\n/* sidebar */\n.sidebar{width:232px;min-width:232px;display:flex;flex-direction:column;padding:22px 16px 20px;background:#fce7ee;border-right:1px solid #f0d3de}\n.brand{display:flex;align-items:center;gap:11px;padding:0 4px}\n.brand-mark{width:36px;height:36px;display:grid;place-items:center;color:#d3007f;flex:0 0 auto}\n.brand-mark svg{width:100%;height:100%}\n.brand-name{display:block;font-size:14px;font-weight:800;letter-spacing:.08em;color:#4a303c;white-space:nowrap}\n.brand-sub{display:block;margin-top:3px;font-size:10px;font-weight:700;letter-spacing:.07em;color:#a3708a;white-space:nowrap}\n.nav-label{margin:28px 12px 10px;font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:#a3708a}\n.nav{display:grid;gap:4px}\n.nav-item{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 12px;border:0;border-radius:10px;background:transparent;color:#6f5462;font-size:14px;text-align:left;cursor:pointer}\n.nav-item i{font-size:18px;color:#a06d85}\n.nav-item.is-current{background:#f7cfdd;color:#4a2f3b;font-weight:700}\n.side-model{margin:24px 2px 0;border:1px solid #efd1dc;border-radius:12px;padding:14px;background:#fff8fb}\n.side-model-label{display:flex;align-items:center;gap:7px;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#a3708a}\n.led{width:7px;height:7px;border-radius:50%;background:#d85a94;display:inline-block}\n.side-model p{margin:10px 0 12px;font-size:14px;font-weight:650;line-height:1.4;color:#4a303c}\n.side-model-foot{display:flex;justify-content:space-between;align-items:center;gap:6px;border-top:1px solid #f0dfe6;padding-top:10px;font-size:11px;letter-spacing:0;color:#a3708a;white-space:nowrap}\n.side-person{display:flex;align-items:center;gap:10px;margin-top:20px;padding:0 4px}\n.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#f7dde7;color:#6b4b5a;font-size:12px;font-weight:800;flex:0 0 auto}\n.side-person b{display:block;font-size:13px;font-weight:700;color:#4a303c}\n.side-person small{display:block;margin-top:2px;font-size:12px;color:#a3708a}\n\n/* main */\n.main{flex:1;min-width:0}\n.topbar{height:65px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 38px;border-bottom:1px solid var(--line);background:#fff9fb}\n.crumbs{display:flex;align-items:center;gap:10px;font-size:13px;color:#96818a}\n.crumbs b{color:#5c3f4c;font-weight:700}\n.scope{display:flex;align-items:center;gap:18px;font-size:13px;color:#6f5464}\n.scope span{display:inline-flex;align-items:center;gap:7px}\n.icon-btn{width:36px;height:36px;display:grid;place-items:center;border:1px solid var(--line);border-radius:9px;background:#fff;color:#7d5a6b;font-size:16px;cursor:pointer}\n.top-avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#f7dde7;color:#6b4b5a;font-size:12px;font-weight:800}\n.inner{max-width:1208px;margin:0 auto;padding:28px 38px 34px}\n\n/* heading */\n.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:24px}\nh1{font-size:44px;line-height:1.08;letter-spacing:-.032em;font-weight:650;color:#33232c}\n.coverage{display:flex;gap:32px;text-align:right}\n.coverage span{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#a08c95}\n.coverage b{display:block;margin-top:6px;font-size:15px;font-weight:700;color:#5c3f4c}\n\n/* kpis */\n.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}\n.kpi{border:1px solid #eee0e6;border-radius:14px;background:#fff;padding:18px 20px;min-height:128px;display:flex;flex-direction:column;justify-content:space-between}\n.kpi.primary{background:linear-gradient(140deg,#fff8fb,#ffe7f0);border-color:#f1c9d9}\n.kpi-label{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#a08c95}\n.kpi-label i{font-size:18px;color:#b5849a}\n.kpi-value{font-size:36px;font-weight:650;line-height:1;letter-spacing:-.03em;color:#33232c;margin-top:14px}\n.kpi-value small{margin-left:8px;font-size:14px;font-weight:500;letter-spacing:0;color:#8d7883}\n.kpi-foot{margin-top:12px;font-size:13px;color:#8d8188}\n\n/* panels */\n.panel{background:#fff;border:1px solid #eee0e6;border-radius:14px;box-shadow:0 2px 10px rgba(46,37,43,.035)}\n.pair{display:grid;grid-template-columns:1.12fr .88fr;gap:20px;align-items:start;margin-bottom:20px}\n.panel-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px 14px}\n.panel-title{font-size:20px;font-weight:650;letter-spacing:-.02em;color:#3a2833}\n.seg{display:inline-flex;gap:2px;padding:3px;border:1px solid #ecdbe2;border-radius:9px;background:#fbf4f7}\n.seg button{min-height:30px;padding:0 12px;border:0;border-radius:7px;background:transparent;color:#957f89;font-size:13px;font-weight:600;cursor:pointer}\n.seg button.on{background:#fff;color:#5c3f4c;box-shadow:0 1px 4px rgba(46,37,43,.12)}\n\n.rank-rows{padding:0 20px}\n.rank-row{display:grid;grid-template-columns:30px minmax(0,1fr) 78px;align-items:center;gap:12px;width:100%;min-height:46px;border:0;background:transparent;padding:0;text-align:left;cursor:pointer}\n.rank-num{font-size:13px;font-weight:700;color:#b8a7ae}\n.rank-main{min-width:0}\n.rank-name{display:block;margin-bottom:7px;font-size:14px;font-weight:650;color:#4d3543;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.track{display:block;height:6px;border-radius:6px;background:#f8e6ed;overflow:hidden}\n.track i{display:block;height:100%;border-radius:inherit;background:#efb9cd}\n.rank-row.on .track i{background:var(--brand)}\n.rank-score{text-align:right;font-size:15px;font-weight:750;color:#5c3f4c}\n.rank-score small{font-size:11px;font-weight:500;color:#a4909b}\n.panel-foot{display:flex;justify-content:space-between;gap:12px;margin:12px 20px 0;padding:12px 0 15px;border-top:1px solid #f4e9ee;font-size:12px;color:#96818a}\n.legend{display:inline-flex;align-items:center;gap:7px}\n.legend i{width:8px;height:8px;border-radius:2px;background:var(--brand);display:inline-block}\n\n/* snapshot */\n.snap-top{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 0}\n.snap-rank{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#a3708a}\n.snap-id{display:flex;align-items:center;gap:14px;padding:18px 20px 0}\n.snap-initials{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:#f9e7ee;border:1px solid #f0dde6;color:#a06a80;font-size:16px;font-weight:800;flex:0 0 auto}\n.snap-name{display:block;font-size:22px;font-weight:650;letter-spacing:-.025em;color:#3a2833}\n.snap-role{display:inline-block;margin-top:6px;padding:3px 8px;border:1px solid #f0dde6;border-radius:6px;background:#fff8fb;font-size:11px;font-weight:700;letter-spacing:.08em;color:#a3708a}\n.snap-score{display:flex;align-items:flex-end;justify-content:space-between;padding:18px 20px 0}\n.snap-score span{font-size:13px;color:#8d7883;padding-bottom:6px}\n.snap-score b{font-size:36px;line-height:1;font-weight:750;letter-spacing:-.03em;color:var(--brand);font-variant-numeric:tabular-nums}\n.snap-score b small{font-size:14px;font-weight:500;letter-spacing:0;color:#a4909b}\n.meter{height:6px;border-radius:6px;background:#f4e6ec;overflow:hidden;margin:12px 20px 0}\n.meter i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#e7a6c0,#c0006f)}\n.snap-metrics{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;margin:18px 20px 0;border-top:1px solid #f2e6ec}\n.snap-metric{padding:12px 0;border-bottom:1px solid #f2e6ec}\n.snap-metric span{display:block;font-size:11px;color:#a08c95}\n.snap-metric b{display:block;margin-top:6px;font-size:21px;font-weight:700;letter-spacing:-.02em;color:#4a323d;font-variant-numeric:tabular-nums}\n.snap-metric b small{margin-left:5px;font-size:12px;font-weight:500;letter-spacing:0;color:#a4909b}\n.snap-foot{display:flex;justify-content:space-between;gap:10px;padding:14px 20px 16px;font-size:12px;color:#96818a}\n\n/* rankings */\n.rankings{margin-bottom:20px;overflow:hidden}\n.rankings-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px 14px}\n.tools{display:flex;align-items:center;gap:10px;padding:0 20px 14px}\n.groups{display:flex;gap:4px;flex-wrap:wrap}\n.group-btn{min-height:32px;padding:0 12px;border:1px solid transparent;border-radius:8px;background:#fbf4f7;color:#8d7883;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap}\n.group-btn.on{background:#fbe3ef;border-color:#f2c9da;color:#a31367}\n.search{display:flex;align-items:center;gap:8px;margin-left:auto;width:250px;height:36px;padding:0 10px;border:1px solid #ecdbe2;border-radius:9px;background:#fff;color:#9c8894;font-size:15px}\n.search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;font-size:14px;color:#5c4451}\n.search input::placeholder{color:#a4909b}\n.table-scroll{overflow-x:auto}\ntable{width:100%;border-collapse:collapse}\nthead{background:#fffafb}\nth{height:44px;padding:0 14px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#a08c95;text-align:left;white-space:nowrap}\nth:first-child,td:first-child{padding-left:20px}\nth:last-child,td:last-child{padding-right:20px}\ntd{height:44px;padding:0 14px;border-top:1px solid #f2e6ec;font-size:14px;color:#6f5464;white-space:nowrap}\ntr.is-selected{background:#fff4f8}\n.player{display:inline-flex;align-items:center;gap:10px;border:0;background:transparent;padding:0;cursor:pointer}\n.initials{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#f9e7ee;border:1px solid #efdde5;color:#986c80;font-size:11px;font-weight:800;flex:0 0 auto}\n.player b{font-size:14px;font-weight:650;color:#4a323d}\n.rank-cell{font-size:13px;font-weight:700;color:#a1939a}\n.rank-cell.top{color:#b6718d}\n.emph{color:#a35474;font-weight:700}\n.score-badge{display:inline-grid;place-items:center;min-width:54px;height:27px;border-radius:7px;background:#fbe3ef;color:#bd006e;font-size:13px;font-weight:800}\n.table-foot{display:flex;justify-content:space-between;gap:12px;padding:14px 20px;border-top:1px solid #f2e6ec;font-size:13px;color:#8d8188}\n\n/* definitions */\n.defs{padding:18px 20px 8px}\n.def-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:0 32px;padding-bottom:12px}\n.def-col h3{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#a3708a;margin:0 0 4px}\n.def{display:grid;grid-template-columns:24px minmax(0,1fr);gap:10px;padding:12px 0;border-top:1px solid #f4e9ee}\n.def-num{font-size:12px;font-weight:700;color:#bda9b2;padding-top:2px}\n.def b{display:block;font-size:14px;font-weight:650;color:#42303a}\n.def p{margin-top:4px;font-size:13px;line-height:1.45;color:#8d8188}\n.footer{display:flex;justify-content:space-between;gap:20px;padding:16px 4px 0;font-size:13px;color:#96818a}\n.footer b{color:#7d5a6b;font-weight:700}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"full-page app layout\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"app sidebar navigation\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo block\">\n<span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon container\">\n<svg data-kid=\"1-1-1-1-1\" data-name=\"hexagonal brand mark icon\" fill=\"none\" viewbox=\"0 0 36 36\"><path d=\"M18 3.5 31 11v14L18 32.5 5 25V11L18 3.5Z\" stroke=\"currentColor\" stroke-width=\"1.6\"></path><path d=\"M11 21.5V14l7-4 7 4v7.5l-7 4-7-4Z\" fill=\"currentColor\"></path><path d=\"m14.5 18 2.2 2.2 4.8-5\" stroke=\"#fff8fb\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\"></path></svg>\n</span>\n<span data-kid=\"1-1-1-2\" data-name=\"brand name and subtitle wrapper\">\n<span class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">PRESSURE<span data-kid=\"1-1-1-2-1-1\" data-name=\"brand slash separator\" style=\"color:#e9a8c4\">/</span>PLAY</span>\n<span class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">CRICKET PERFORMANCE</span>\n</span>\n</div>\n<div class=\"nav-label\" data-kid=\"1-1-2\" data-name=\"sidebar section label\">Workspace</div>\n<nav aria-label=\"Dashboard sections\" class=\"nav\" data-kid=\"1-1-3\" data-name=\"sidebar dashboard navigation\">\n<button class=\"nav-item is-current\" data-kid=\"1-1-3-1\" data-name=\"overview nav item (active)\" type=\"button\"><i class=\"icon-layout-dashboard\" data-kid=\"1-1-3-1-1\" data-name=\"overview layout icon\"></i><span data-kid=\"1-1-3-1-2\" data-name=\"overview nav label\">Overview</span></button>\n<button class=\"nav-item\" data-kid=\"1-1-3-2\" data-name=\"batting nav item\" type=\"button\"><i class=\"icon-trending-up\" data-kid=\"1-1-3-2-1\" data-name=\"batting trend icon\"></i><span data-kid=\"1-1-3-2-2\" data-name=\"batting nav label\">Batting</span></button>\n<button class=\"nav-item\" data-kid=\"1-1-3-3\" data-name=\"bowling nav item\" type=\"button\"><i class=\"icon-target\" data-kid=\"1-1-3-3-1\" data-name=\"bowling target icon\"></i><span data-kid=\"1-1-3-3-2\" data-name=\"bowling nav label\">Bowling</span></button>\n</nav>\n<div class=\"side-model\" data-kid=\"1-1-4\" data